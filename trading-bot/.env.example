# Alpaca PAPER TRADING keys (free, no real money).
# Get them from https://app.alpaca.markets/paper/dashboard/overview
# (Dashboard -> "Generate New Key" while the "Paper Trading" toggle is ON).
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Never point this at the live trading endpoint until you have backtested
# and paper-traded the strategy for a meaningful stretch of time.
ALPACA_PAPER=true

# Canale dati di mercato: "iex" (incluso negli account gratuiti) oppure
# "sip" (tutte le borse USA, richiede abbonamento a pagamento). Con un
# account gratuito lascia iex: con sip le richieste su dati recenti
# falliscono ("subscription does not permit querying recent SIP data").
ALPACA_DATA_FEED=iex

# Time (24h, exchange timezone America/New_York) at which the daily
# short-term cycle runs. Should be a few minutes before market close so
# the day's bar is (almost) complete.
RUN_TIME=16:15

# URL webhook opzionale (Discord/Slack/endpoint generico che accetta
# {"text": "..."}) per notifiche di ordini eseguiti ed errori. Vuoto =
# notifiche disattivate (default). Vedi README "Notifiche".
ALERT_WEBHOOK_URL=

# --- Lungo termine (long_term/) -- vedi STRATEGY.md Parte 1 -----------------
LONG_TERM_CAPITAL=10000
# Punteggio del questionario di profilazione del rischio (vedi STRATEGY.md
# 1.2 per le fasce: <18, 19-22, 23-28, 29-32, 33+)
LONG_TERM_RISK_SCORE=25

# ETF Harry Browne: azionario, obbligazionario lungo, obbligazionario
# breve, oro (25% ciascuno)
HARRY_BROWNE_TICKERS=VT,TLT,SHY,GLD

# ETF Advanced (diversi da quelli sopra): azionario, obbligazionario
# lungo, obbligazionario breve, oro, immobiliare
ADVANCED_TICKERS=VTI,EDV,VGSH,IAU,VNQ
ADVANCED_SMA_PERIOD=10
# Split obbligazionario lungo/breve nel peso "obbligazioni" del profilo di
# rischio -- non specificato dal corso, assunzione esplicita (default 50/50)
ADVANCED_BOND_LONG_SPLIT=0.5

# quarterly|semiannual|annual -- mai a soglia di scostamento
REBALANCE_FREQUENCY=quarterly

# Portafoglio di lungo termine gestito in AUTOMATICO dallo scheduler:
#   advanced      -> dentro/fuori per asset sulla SMA10 mensile (1 decisione/mese)
#   harry_browne  -> ribilanciamento al 25% ogni REBALANCE_FREQUENCY
#   none          -> lungo termine solo a mano (long-term-status / long-term-pac)
# Usa LONG_TERM_CAPITAL come capitale massimo. Vedi README "Lungo termine
# automatico".
LONG_TERM_AUTO_STRATEGY=advanced

# --- Breve termine (short_term/) -- vedi STRATEGY.md Parte 2 ----------------
SHORT_TERM_CAPITAL=10000
# Universo validato nel backtest storico 2000-2026 (vedi STRATEGY.md), incluse
# 8 ADR non-USA (Toyota, ASML, TSMC, Novo Nordisk, TotalEnergies, Rio Tinto,
# Sony, BHP) validate separatamente con win rate 54-75%. Usato solo se
# SHORT_TERM_USE_FULL_MARKET=false (di default e' true: si scansiona tutto
# il mercato e questa lista viene ignorata).
SHORT_TERM_WATCHLIST=AAPL,MSFT,INTC,IBM,JPM,XOM,WMT,KO,JNJ,PG,HD,CAT,GE,DIS,CSCO,MCD,PFE,VZ,CVX,MMM,AMZN,NVDA,NFLX,ADBE,CRM,GOOGL,NKE,COST,QCOM,AMAT,TSLA,META,V,MA,ASML,TM,TSM,NVO,TTE,RIO,SONY,BHP

# DEFAULT: true. Ignora SHORT_TERM_WATCHLIST e scansiona TUTTO il mercato
# USA (ogni titolo tradable via Alpaca), con prefiltri di liquidita' e
# volatilita' prima della pipeline completa -- vedi README "Universo
# full-market". Richiede le chiavi Alpaca anche solo per lo screening.
# false = torna alla watchlist fissa qui sopra.
SHORT_TERM_USE_FULL_MARKET=true
SHORT_TERM_MIN_PRICE_FULL_MARKET=10.0
SHORT_TERM_MIN_DOLLAR_VOLUME=5000000
SHORT_TERM_FULL_MARKET_MAX_SYMBOLS=300
# Volatilita' storica annualizzata minima (%) per il prefiltro full-market:
# esclude le difensive piatte su cui il sistema rende peggio (STRATEGY.md v4)
SHORT_TERM_MIN_ANNUALIZED_VOLATILITY_PCT=25.0

SHORT_TERM_ACCOUNT_CURRENCY=USD
SHORT_TERM_FX_RATE=1.0

# Money management (1-2% per operazione, 0.5-1% per chi inizia)
SHORT_TERM_RISK_PER_TRADE_PCT=1.0
# Tetto di rischio aggregato su tutte le posizioni aperte (10-12%)
SHORT_TERM_MAX_AGGREGATE_RISK_PCT=12.0

# Qualificazione del trend
TREND_LOOKBACK_DAYS=60
TREND_MIN_QUALIFIERS=2
TREND_PERFORMANCE_THRESHOLD_PCT=30.0
TREND_ADX_THRESHOLD=30.0
TREND_PERSISTENCE_WINDOW=20
# Movimento netto minimo (%) sulla finestra di persistenza perché conti come
# "diretto" (default: derivato da TREND_PERFORMANCE_THRESHOLD_PCT scalato
# sulla finestra di persistenza, vedi common/config.py)
PERSISTENCE_MIN_NET_MOVE_PCT=10.0
# "Ampio range" = range della barra >= questo multiplo della volatilità
# media (convenzione standard "wide-range bar", il corso non dà un numero)
WIDE_RANGE_ATR_MULT=1.5
# Gap = apertura oltre questo multiplo della volatilità media dalla
# chiusura precedente (soglia relativa alla volatilità del titolo, non una
# % fissa uguale per tutti -- convenzione standard, il corso non dà un numero)
GAP_VOLATILITY_MULT=0.5
# Separazione minima (% del prezzo) tra EMA brevi e lunghe perché il fascio
# conti come "pulito" (il corso non dà un numero, solo "intrecciate si/no")
RIBBON_MIN_SEPARATION_PCT=0.3

# Indicatore di volatilità per i livelli di entrata/stop (media mobile del
# range max-min sulle ultime N barre)
VOLATILITY_PERIOD=10

# Filtri di rischio aggiuntivi
EARNINGS_WARNING_DAYS=15
SUPPORT_RESISTANCE_MIN_R_MULTIPLE=3.0
SHORT_MIN_PRICE=80.0

SECTOR_RS_LOOKBACK_DAYS=60

# Filtro di regime di mercato (validato nel backtest, vedi STRATEGY.md "v5"):
# long solo se SPY chiude sopra la sua SMA200, short solo se sotto.
MARKET_REGIME_FILTER=true
MARKET_REGIME_MA_PERIOD=200

# Short: previsti dal corso e implementati, ma in perdita netta in OGNI
# backtest 2000-2026; senza short migliorano tutte le metriche (vedi
# STRATEGY.md "v6"). Default: solo long. true = riattiva gli short.
SHORT_TERM_ALLOW_SHORTS=false

# Freno di drawdown: sotto questa % dal massimo dell'equity dell'ultimo anno
# il bot non apre nuove posizioni finche' non recupera. 0 = disattivato
# (default): misurato al 15% su 26 anni PEGGIORA sia il rendimento sia il
# drawdown, perche' blocca le entrate vicino ai minimi e fa perdere il
# rimbalzo (vedi STRATEGY.md "v8b").
SHORT_TERM_MAX_DRAWDOWN_PCT=0
# Tetto di sicurezza (giorni) per un ordine d'ingresso pendente non eseguito
SHORT_TERM_PENDING_MAX_DAYS=20
# Volume minimo in pezzi per il prefiltro full-market (corso: >100k/giorno)
SHORT_TERM_MIN_SHARE_VOLUME=100000
