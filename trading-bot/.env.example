# Alpaca PAPER TRADING keys (free, no real money).
# Get them from https://app.alpaca.markets/paper/dashboard/overview
# (Dashboard -> "Generate New Key" while the "Paper Trading" toggle is ON).
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Never point this at the live trading endpoint until you have backtested
# and paper-traded the strategy for a meaningful stretch of time.
ALPACA_PAPER=true

# Time (24h, exchange timezone America/New_York) at which the daily
# short-term cycle runs. Should be a few minutes before market close so
# the day's bar is (almost) complete.
RUN_TIME=15:50

# --- Lungo termine (long_term/) -- vedi STRATEGY.md Parte 1 -----------------
LONG_TERM_CAPITAL=10000
# Punteggio del questionario di profilazione del rischio (vedi STRATEGY.md
# 1.2 per le fasce: <18, 19-22, 23-28, 29-32, 33+)
LONG_TERM_RISK_SCORE=25

# ETF Harry Browne: azionario, obbligazionario lungo, obbligazionario
# breve, oro (25% ciascuno)
HARRY_BROWNE_TICKERS=VT,TLT,SHY,GLD

# ETF Advanced (diversi da quelli sopra): azionario, obbligazionario
# lungo, obbligazionario breve, oro, immobiliare
ADVANCED_TICKERS=VTI,EDV,VGSH,IAU,VNQ
ADVANCED_SMA_PERIOD=10
# Split obbligazionario lungo/breve nel peso "obbligazioni" del profilo di
# rischio -- non specificato dal corso, assunzione esplicita (default 50/50)
ADVANCED_BOND_LONG_SPLIT=0.5

# quarterly|semiannual|annual -- mai a soglia di scostamento
REBALANCE_FREQUENCY=quarterly

# --- Breve termine (short_term/) -- vedi STRATEGY.md Parte 2 ----------------
SHORT_TERM_CAPITAL=10000
SHORT_TERM_WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,NFLX,CRM
SHORT_TERM_ACCOUNT_CURRENCY=USD
SHORT_TERM_FX_RATE=1.0

# Money management (1-2% per operazione, 0.5-1% per chi inizia)
SHORT_TERM_RISK_PER_TRADE_PCT=1.0
# Tetto di rischio aggregato su tutte le posizioni aperte (10-12%)
SHORT_TERM_MAX_AGGREGATE_RISK_PCT=12.0

# Qualificazione del trend
TREND_LOOKBACK_DAYS=60
TREND_MIN_QUALIFIERS=2
TREND_PERFORMANCE_THRESHOLD_PCT=30.0
TREND_ADX_THRESHOLD=30.0
TREND_PERSISTENCE_WINDOW=20
# Movimento netto minimo (%) sulla finestra di persistenza perché conti come
# "diretto" (default: derivato da TREND_PERFORMANCE_THRESHOLD_PCT scalato
# sulla finestra di persistenza, vedi common/config.py)
PERSISTENCE_MIN_NET_MOVE_PCT=10.0
# "Ampio range" = range della barra >= questo multiplo della volatilità
# media (convenzione standard "wide-range bar", il corso non dà un numero)
WIDE_RANGE_ATR_MULT=1.5
# Separazione minima (% del prezzo) tra EMA brevi e lunghe perché il fascio
# conti come "pulito" (il corso non dà un numero, solo "intrecciate si/no")
RIBBON_MIN_SEPARATION_PCT=0.3

# Indicatore di volatilità per i livelli di entrata/stop (media mobile del
# range max-min sulle ultime N barre)
VOLATILITY_PERIOD=10

# Filtri di rischio aggiuntivi
EARNINGS_WARNING_DAYS=15
SUPPORT_RESISTANCE_MIN_R_MULTIPLE=3.0
SHORT_MIN_PRICE=80.0

SECTOR_RS_LOOKBACK_DAYS=60
