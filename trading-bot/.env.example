# Alpaca PAPER TRADING keys (free, no real money).
# Get them from https://app.alpaca.markets/paper/dashboard/overview
# (Dashboard -> "Generate New Key" while the "Paper Trading" toggle is ON).
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Never point this at the live trading endpoint until you have backtested
# and paper-traded the strategy for a meaningful stretch of time.
ALPACA_PAPER=true

# Comma-separated list of tickers to watch/trade.
WATCHLIST=AAPL,MSFT,SPY,QQQ

# Risk management
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=20.0

# Strategy parameters
SMA_FAST=20
SMA_SLOW=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
ATR_STOP_MULT=1.5
REWARD_RISK_RATIO=2.0

# Time (24h, exchange timezone America/New_York) at which the daily bot
# cycle runs. Should be a few minutes before market close so the day's
# bar is (almost) complete.
RUN_TIME=15:50
